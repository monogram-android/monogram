{
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Schema",
    "description": "A complete schema suitable for generators in any language.",
    "type": "object",
    "properties": {
      "constructors": {
        "description": "Constructors, in source order.",
        "type": "array",
        "items": {
          "$ref": "#/$defs/Combinator"
        }
      },
      "finalizations": {
        "description": "Finalization declarations.",
        "type": "array",
        "items": {
          "$ref": "#/$defs/Finalization"
        }
      },
      "format_version": {
        "description": "Interchange format version (independent of Telegram's layer).",
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      },
      "functions": {
        "description": "RPC methods, in source order.",
        "type": "array",
        "items": {
          "$ref": "#/$defs/Combinator"
        }
      },
      "layer": {
        "description": "Telegram API layer advertised by the source.",
        "type": [
          "integer",
          "null"
        ],
        "format": "uint32",
        "minimum": 0
      },
      "partial_applications": {
        "description": "Template/partial application declarations.",
        "type": "array",
        "items": {
          "$ref": "#/$defs/Expression"
        }
      },
      "source": {
        "description": "Provenance supplied by the caller.",
        "$ref": "#/$defs/Source"
      }
    },
    "required": [
      "format_version",
      "source",
      "constructors",
      "functions",
      "finalizations",
      "partial_applications"
    ],
    "$defs": {
      "Argument": {
        "description": "One argument.",
        "type": "object",
        "properties": {
          "condition": {
            "description": "Optional bit guard.",
            "anyOf": [
              {
                "$ref": "#/$defs/Condition"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "description": "Documentation derived from `@param`.",
            "type": [
              "string",
              "null"
            ]
          },
          "functional": {
            "description": "Functional/exclamation argument.",
            "type": "boolean"
          },
          "implicit": {
            "description": "Implicit/braced generic argument.",
            "type": "boolean"
          },
          "name": {
            "description": "TL field name.",
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "description": "Ordinary value or repeated field group.",
            "$ref": "#/$defs/ArgumentValue"
          }
        },
        "required": [
          "value",
          "implicit",
          "functional"
        ]
      },
      "ArgumentValue": {
        "description": "The mutually exclusive forms of a combinator argument.",
        "oneOf": [
          {
            "description": "One value with a TL type expression.",
            "type": "object",
            "properties": {
              "expression": {
                "description": "Parsed expression; never a schema-name placeholder.",
                "$ref": "#/$defs/Expression"
              },
              "kind": {
                "type": "string",
                "const": "type"
              }
            },
            "required": [
              "kind",
              "expression"
            ]
          },
          {
            "description": "A bracketed group repeated according to a natural expression.",
            "type": "object",
            "properties": {
              "arguments": {
                "description": "Fields in one repeated element.",
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Argument"
                }
              },
              "kind": {
                "type": "string",
                "const": "repetition"
              },
              "multiplicity": {
                "description": "Count expression, or the preceding natural argument when omitted.",
                "anyOf": [
                  {
                    "$ref": "#/$defs/Expression"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "kind",
              "arguments"
            ]
          }
        ]
      },
      "Combinator": {
        "description": "A constructor or function.",
        "type": "object",
        "properties": {
          "arguments": {
            "description": "Ordered arguments.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/Argument"
            }
          },
          "builtin": {
            "description": "Built-in pseudo-declaration.",
            "type": "boolean"
          },
          "documentation": {
            "description": "Structured documentation.",
            "$ref": "#/$defs/Documentation"
          },
          "id": {
            "description": "Resolved constructor number (explicit or canonical CRC32).",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "id_explicit": {
            "description": "Whether the source supplied the number instead of relying on canonical CRC32.",
            "type": "boolean"
          },
          "id_hex": {
            "description": "Hex form convenient for languages with awkward unsigned integers.",
            "type": "string"
          },
          "kind": {
            "description": "Constructor or function.",
            "$ref": "#/$defs/CombinatorKind"
          },
          "layer": {
            "description": "Layer known for this declaration. Current flat schemas only identify the\ncontaining layer and cannot prove an earlier introduction layer.",
            "$ref": "#/$defs/LayerInfo"
          },
          "name": {
            "description": "Namespace-qualified TL name.",
            "type": "string"
          },
          "result": {
            "description": "Result expression.",
            "$ref": "#/$defs/Expression"
          }
        },
        "required": [
          "name",
          "id",
          "id_hex",
          "id_explicit",
          "kind",
          "arguments",
          "result",
          "documentation",
          "layer",
          "builtin"
        ]
      },
      "CombinatorKind": {
        "description": "Kind of combinator.",
        "oneOf": [
          {
            "description": "Data constructor.",
            "type": "string",
            "const": "constructor"
          },
          {
            "description": "RPC function.",
            "type": "string",
            "const": "function"
          }
        ]
      },
      "Condition": {
        "description": "Optional-field condition.",
        "type": "object",
        "properties": {
          "bit": {
            "description": "Optional bit number.",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint32",
            "minimum": 0
          },
          "variable": {
            "description": "Flags/natural argument name.",
            "type": "string"
          }
        },
        "required": [
          "variable"
        ]
      },
      "Documentation": {
        "description": "Documentation and cross-language official links.",
        "type": "object",
        "properties": {
          "description": {
            "description": "Prose description.",
            "type": [
              "string",
              "null"
            ]
          },
          "links": {
            "description": "Other URLs found in comments.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "official_url": {
            "description": "Official Telegram documentation page inferred from the declaration kind.",
            "type": [
              "string",
              "null"
            ]
          },
          "parameters": {
            "description": "Named parameter descriptions.",
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "parameters",
          "links"
        ]
      },
      "Expression": {
        "description": "Language-neutral expression tree.",
        "oneOf": [
          {
            "description": "An identifier.",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "ident"
              },
              "name": {
                "description": "Namespace-qualified TL spelling.",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "name"
            ]
          },
          {
            "description": "Natural constant.",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "nat"
              },
              "value": {
                "description": "Constant value.",
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "value"
            ]
          },
          {
            "description": "The natural-number type `#`.",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "hash"
              }
            },
            "required": [
              "kind"
            ]
          },
          {
            "description": "Natural addition supported by the TL formal grammar.",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "add"
              },
              "left": {
                "description": "Left operand.",
                "$ref": "#/$defs/Expression"
              },
              "right": {
                "description": "Right operand.",
                "$ref": "#/$defs/Expression"
              }
            },
            "required": [
              "kind",
              "left",
              "right"
            ]
          },
          {
            "description": "Applied type expression.",
            "type": "object",
            "properties": {
              "arguments": {
                "description": "Application arguments.",
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Expression"
                }
              },
              "constructor": {
                "description": "Applied constructor/type.",
                "$ref": "#/$defs/Expression"
              },
              "kind": {
                "type": "string",
                "const": "apply"
              }
            },
            "required": [
              "kind",
              "constructor",
              "arguments"
            ]
          },
          {
            "description": "Bare type expression.",
            "type": "object",
            "properties": {
              "inner": {
                "description": "Wrapped expression.",
                "$ref": "#/$defs/Expression"
              },
              "kind": {
                "type": "string",
                "const": "bare"
              }
            },
            "required": [
              "kind",
              "inner"
            ]
          },
          {
            "description": "Functional type expression.",
            "type": "object",
            "properties": {
              "inner": {
                "description": "Wrapped expression.",
                "$ref": "#/$defs/Expression"
              },
              "kind": {
                "type": "string",
                "const": "bang"
              }
            },
            "required": [
              "kind",
              "inner"
            ]
          }
        ]
      },
      "Finalization": {
        "description": "`New`, `Final`, or `Empty` type declaration.",
        "type": "object",
        "properties": {
          "mode": {
            "description": "Lowercase finalization mode.",
            "type": "string"
          },
          "type": {
            "description": "Affected type.",
            "$ref": "#/$defs/Expression"
          }
        },
        "required": [
          "mode",
          "type"
        ]
      },
      "LayerInfo": {
        "description": "Layer metadata with explicit semantics.",
        "type": "object",
        "properties": {
          "introduced": {
            "description": "First layer, only when the input explicitly provides it.",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint32",
            "minimum": 0
          },
          "schema": {
            "description": "Layer of the containing schema.",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint32",
            "minimum": 0
          }
        }
      },
      "Source": {
        "description": "Input provenance.",
        "type": "object",
        "properties": {
          "name": {
            "description": "Human-readable file or URL.",
            "type": "string"
          },
          "url": {
            "description": "Upstream URL, when known.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ]
      }
    }
  },
